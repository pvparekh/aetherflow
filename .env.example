# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model provider (see docs/leak-finder/01-architecture.md)
# Local development: leave LLM_BASE_URL unset to use Ollama at http://localhost:11434/v1
# Cloudflare Workers AI: https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
# Optional per-task overrides: LLM_MODEL_CATEGORIZE, LLM_MODEL_EXTRACT, LLM_MODEL_NARRATIVE, LLM_MODEL_ASK, LLM_MODEL_DRAFT

# Legacy: a bare OpenAI key selects OpenAI when LLM_BASE_URL is unset
OPENAI_API_KEY=
